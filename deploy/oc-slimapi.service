# oc-slimapi — systemd **user** service unit template.
#
# 部署到 ~/.config/systemd/user/oc-slimapi.service（systemctl --user）。
# 这是 user service：deliberately **不含** ProtectSystem/ProtectHome/
# ProtectKernel*/NoNewPrivileges 等 sandbox —— 它们需要 root（capability drop），
# user manager 无权设置，会以 status=218/CAPABILITIES 失败。
# 进程隔离靠 stunnel mTLS（:14097/:14096）+ Tailscale ACL（见 AGENTS.md）。
# 部署/更新步骤见 docs/operations.md §3。

[Unit]
Description=oc-slimapi (Python 省流 sidecar for ocdroid ↔ opencode)
Documentation=file:///home/mar/personal_projects/oc-slimapi/AGENTS.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mar/personal_projects/oc-slimapi
ExecStart=/home/mar/personal_projects/oc-slimapi/.venv/bin/python -m oc_slimapi.app
Restart=on-failure
RestartSec=5
# P0-1: systemd 15s upper bound for SIGTERM graceful shutdown — sits above
# uvicorn's 5s timeout_graceful_shutdown so the process has a chance to drain
# active SSE connections before the 90s SIGKILL default kicks in.
TimeoutStopSec=15

# OC_SLIMAPI_HOST=0.0.0.0 允许 Tailscale 直连；如仅 loopback（stunnel 本机转发）改 127.0.0.1。
# :4097 为明文，远程暴露必须靠 stunnel mTLS / Tailscale ACL 隔离。
Environment=OC_SLIMAPI_HOST=0.0.0.0
Environment=OC_SLIMAPI_PORT=4097
Environment=OC_SLIMAPI_UPSTREAM=http://127.0.0.1:4096
Environment=OC_SLIMAPI_MAX_MESSAGE_BYTES=33554432
# 版本窗自 4.0.0 起由代码钉死 (3,4)（config.validate fail-closed）——勿设置版本相关 env
Environment=PYTHONUNBUFFERED=1

# v1.0.0: access log + traffic snapshot 落 StateDirectory（systemd 自动建
# ~/.local/state/oc-slimapi 并允许写入）。代码默认相对 logs/（本地开发 cwd 可写），
# 生产由下面两行 env 覆盖到 state dir。
StateDirectory=oc-slimapi
Environment=OC_SLIMAPI_ACCESS_LOG_DIR=%S/oc-slimapi/logs
Environment=OC_SLIMAPI_TRAFFIC_SNAPSHOT_PATH=%S/oc-slimapi/logs/traffic-snapshot.jsonl
# F-009: prune traffic-snapshot-YYYY-MM-DD.jsonl(.gz) older than 30 days.
# Retention is self-managed by the snapshotter's own loop (every tick,
# independent of ACCESS_LOG_ENABLED; no piggyback on the access-log
# maintenance loop). 0 = never prune (code default for local dev).
Environment=OC_SLIMAPI_TRAFFIC_SNAPSHOT_RETAIN_DAYS=30
Environment=OC_SLIMAPI_ACCESS_LOG_RETAIN_DAYS=3
# T9 (P1-4): incarnation state lives in its OWN dir, separate from access
# logs (%S/oc-slimapi/incarnation vs %S/oc-slimapi/logs). On first upgrade
# from a pre-T9 deployment, the legacy incarnation file under the old
# access-log dir is read + migrated (value+1 written to the new path,
# monotonic — no reset); the legacy file is preserved (never deleted).
# New path takes priority; legacy is consulted only when the new path is
# missing/corrupt.
Environment=OC_SLIMAPI_STATE_DIR=%S/oc-slimapi

# /slimapi/actions manifest (opt-in; unset = feature disabled).
# Manifest must be a regular file, owner-only-write (chmod 0600), owned by the
# runtime user. Reference: deploy/actions.manifest.example.toml. Spec/ops:
# docs/specs/v2-contract.md §2 + docs/operations.md §11.
#Environment=OC_SLIMAPI_ACTIONS_FILE=%h/.config/oc-slimapi/actions.toml

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oc-slimapi

# Memory hard cap. The arithmetic of max_transforms=1 + max_response_bytes=64MiB
# + 16MiB inline cap + Python/Baseline RSS fits under 384M (see design-v2 §0.10,
# transform.py docstring). cgroup-enforced OOM kill protects the host if a
# runaway upstream body ever bypasses the read_with_cap fences.
MemoryMax=384M

[Install]
WantedBy=default.target
